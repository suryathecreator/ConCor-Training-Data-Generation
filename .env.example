# Persistent storage (do not put credentials in this file if it will be committed).
HF_HOME=/path/to/persistent/huggingface-cache
QWEN_SOURCE=/path/to/Qwen3.8-27B
SAM3_CHECKPOINT_SOURCE=/path/to/sam3.pt
SAM3_REPO_ROOT=/path/to/facebookresearch/sam3

# Slurm installation details.
CPU_PARTITION=cpu
GPU_ACCOUNT=your_gpu_account
CPU_ACCOUNT=your_cpu_account
A40_PARTITION=gpu-a40
H200_PARTITION=gpu-h200
