{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huggingface.co/datasets/suryadv/gpic-bcc-sam3-qwen38-27b/raw/main/schema/bcc_record.schema.json",
  "title": "GPIC BCC portable row",
  "type": "object",
  "required": [
    "image_id",
    "source_manifest_index",
    "sam3_proposal_count",
    "post_consistency_mask_count",
    "final_linked_mask_count",
    "bcc_parseable",
    "included_min_10",
    "disposition",
    "accepted_mask_rles_json",
    "post_consistency_mask_rles_json",
    "correspondence_groups_json",
    "bcc_record_json"
  ],
  "properties": {
    "dataset_export_version": {"type": "string"},
    "image_id": {"type": "string"},
    "source_manifest_index": {"type": "integer", "minimum": 0},
    "source_dataset": {"type": "string"},
    "source_split": {"type": "string"},
    "source_pair_key": {"type": "string"},
    "image_filename": {"type": "string"},
    "image_mime_type": {"type": "string"},
    "image_bytes": {"description": "Binary source-image payload"},
    "image_review_accepted": {"type": ["boolean", "null"]},
    "sam3_proposal_count": {"type": "integer", "minimum": 0},
    "post_consistency_mask_count": {"type": "integer", "minimum": 0},
    "final_linked_mask_count": {"type": "integer", "minimum": 0},
    "bcc_parseable": {"type": "boolean"},
    "included_min_10": {"type": "boolean"},
    "disposition": {"type": "string"},
    "caption": {"type": "string"},
    "accepted_mask_rles_json": {"type": "string", "description": "RLEs only for masks linked by final correspondence groups"},
    "post_consistency_mask_rles_json": {"type": "string", "description": "RLEs for every mask surviving SAM3 consistency, including masks omitted by the caption"},
    "correspondence_groups_json": {"type": "string"},
    "bcc_record_json": {"type": "string"}
  },
  "additionalProperties": false
}
